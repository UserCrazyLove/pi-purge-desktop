# Normalize line endings in the repository, check out with LF by default.
* text=auto eol=lf

# Source and data files: always LF, never platform-converted.
*.mjs    text eol=lf
*.cjs    text eol=lf
*.js     text eol=lf
*.ts     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf

# Windows-only entry points need CRLF so cmd.exe and legacy tooling read them correctly.
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binary artefacts: no text conversion, no diff, no merge.
*.piplug binary
docs/*.png binary
